{
  "name": "vehicle-debugging-assistant",
  "displayName": "Vehicle Debugging Assistant",
  "description": "Assistant de débogage véhicule : analyse d'erreurs UDS/OBD-II, DTC, logs CAN et diagnostics AUTOSAR pour le développement automobile safety-critical.",
  "version": "0.1.1",
  "publisher": "vehicle-debug",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Debuggers", "Other"],
  "keywords": ["automotive", "uds", "obd", "autosar", "diagnostics", "iso26262", "doip"],
  "activationEvents": [
    "onView:vehicleDebug.dtcView",
    "onView:vehicleDebug.healthView",
    "onCommand:vehicleDebug.connectEcu",
    "onCommand:vehicleDebug.setVin",
    "onCommand:vehicleDebug.readVinFromDid",
    "onCommand:vehicleDebug.refreshHealth",
    "onCommand:vehicleDebug.exportHealthSnapshot",
    "onCommand:vehicleDebug.openTriageRules",
    "onCommand:vehicleDebug.readDtcs",
    "onCommand:vehicleDebug.analyzeLog",
    "onCommand:vehicleDebug.doipDiscover"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "vehicleDebug.connectEcu", "title": "Connect to ECU", "category": "Vehicle Debug", "icon": "$(plug)" },
      { "command": "vehicleDebug.disconnectEcu", "title": "Disconnect ECU", "category": "Vehicle Debug", "icon": "$(debug-disconnect)" },
      { "command": "vehicleDebug.readDtcs", "title": "Read DTCs", "category": "Vehicle Debug", "icon": "$(list-unordered)" },
      { "command": "vehicleDebug.clearDtcs", "title": "Clear DTCs", "category": "Vehicle Debug", "icon": "$(trash)" },
      { "command": "vehicleDebug.analyzeLog", "title": "Analyze Log File", "category": "Vehicle Debug", "icon": "$(file-text)" },
      { "command": "vehicleDebug.readDid", "title": "Read Data Identifier (DID)", "category": "Vehicle Debug", "icon": "$(symbol-key)" },
      { "command": "vehicleDebug.showReport", "title": "Show Analysis Report", "category": "Vehicle Debug", "icon": "$(report)" },
      { "command": "vehicleDebug.refreshViews", "title": "Refresh Views", "category": "Vehicle Debug", "icon": "$(refresh)" },
      { "command": "vehicleDebug.openSampleLog", "title": "Open Sample Trace Log", "category": "Vehicle Debug", "icon": "$(file)" },
      { "command": "vehicleDebug.configureConnections", "title": "Configure Connections…", "category": "Vehicle Debug", "icon": "$(settings-gear)" },
      { "command": "vehicleDebug.testConnection", "title": "Test Selected Connection", "category": "Vehicle Debug", "icon": "$(debug-start)" },
      { "command": "vehicleDebug.setConnectionSecret", "title": "Set Connection Token / Password", "category": "Vehicle Debug", "icon": "$(key)" },
      { "command": "vehicleDebug.aiAnalyzeSelection", "title": "AI: Analyze Selection / Log", "category": "Vehicle Debug", "icon": "$(sparkle)" },
      { "command": "vehicleDebug.aiAnalyzeAll", "title": "AI: Analyze All Errors & DTCs", "category": "Vehicle Debug", "icon": "$(sparkle)" },
      { "command": "vehicleDebug.aiAnalyzeError", "title": "AI: Analyze This Error", "category": "Vehicle Debug", "icon": "$(sparkle)" },
      { "command": "vehicleDebug.aiAnalyzeDtc", "title": "AI: Analyze This DTC", "category": "Vehicle Debug", "icon": "$(sparkle)" },
      { "command": "vehicleDebug.createTicketFromError", "title": "Create Ticket from Error", "category": "Vehicle Debug", "icon": "$(issues)" },
      { "command": "vehicleDebug.createTicketFromDtc", "title": "Create Ticket from DTC", "category": "Vehicle Debug", "icon": "$(issues)" },
      { "command": "vehicleDebug.exportConfluence", "title": "Export Report to Confluence", "category": "Vehicle Debug", "icon": "$(cloud-upload)" },
      { "command": "vehicleDebug.importCicdReport", "title": "Import CI/CD Analysis Report", "category": "Vehicle Debug", "icon": "$(cloud-download)" },
      { "command": "vehicleDebug.analyzeArxml", "title": "Analyze ARXML (DEM/DCM/DTC)", "category": "Vehicle Debug", "icon": "$(file-code)" },
      { "command": "vehicleDebug.doipDiscover", "title": "DoIP: Vehicle Discovery", "category": "Vehicle Debug", "icon": "$(broadcast)" },
      { "command": "vehicleDebug.setVin", "title": "Set Vehicle VIN / ID", "category": "Vehicle Debug", "icon": "$(tag)" },
      { "command": "vehicleDebug.readVinFromDid", "title": "Read VIN (DID F190)", "category": "Vehicle Debug", "icon": "$(key)" },
      { "command": "vehicleDebug.refreshHealth", "title": "Refresh Vehicle Health", "category": "Vehicle Debug", "icon": "$(heart)" },
      { "command": "vehicleDebug.exportHealthSnapshot", "title": "Export Health Snapshot", "category": "Vehicle Debug", "icon": "$(export)" },
      { "command": "vehicleDebug.openTriageRules", "title": "Open / Create Triage Rules", "category": "Vehicle Debug", "icon": "$(symbol-ruler)" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "vehicle-debug", "title": "Vehicle Debug", "icon": "media/car.svg" }]
    },
    "views": {
      "vehicle-debug": [
        { "id": "vehicleDebug.healthView", "name": "Vehicle Health", "icon": "$(heart)", "contextualTitle": "Unified health & triage" },
        { "id": "vehicleDebug.dtcView", "name": "DTCs" },
        { "id": "vehicleDebug.errorView", "name": "Errors Analysis" },
        { "id": "vehicleDebug.sessionView", "name": "Session & Status" },
        { "id": "vehicleDebug.connectionsView", "name": "Connections" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "vehicleDebug.refreshViews", "when": "view == vehicleDebug.dtcView || view == vehicleDebug.errorView", "group": "navigation" },
        { "command": "vehicleDebug.refreshHealth", "when": "view == vehicleDebug.healthView", "group": "navigation" },
        { "command": "vehicleDebug.exportHealthSnapshot", "when": "view == vehicleDebug.healthView", "group": "navigation" },
        { "command": "vehicleDebug.readDtcs", "when": "view == vehicleDebug.dtcView", "group": "navigation" },
        { "command": "vehicleDebug.configureConnections", "when": "view == vehicleDebug.connectionsView", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "Vehicle Debugging Assistant",
      "properties": {
        "vehicleDebug.pythonPath": { "type": "string", "default": "python3" },
        "vehicleDebug.pythonTimeoutMs": { "type": "number", "default": 60000, "minimum": 1000, "maximum": 600000 },
        "vehicleDebug.canInterface": { "type": "string", "default": "socketcan", "enum": ["socketcan", "vector", "pcan", "virtual"] },
        "vehicleDebug.canChannel": { "type": "string", "default": "can0" },
        "vehicleDebug.txId": { "type": "string", "default": "0x7E0" },
        "vehicleDebug.rxId": { "type": "string", "default": "0x7E8" },
        "vehicleDebug.defaultSession": { "type": "string", "default": "extended" },
        "vehicleDebug.enableSafetyClassification": { "type": "boolean", "default": true },
        "vehicleDebug.transport": { "type": "string", "default": "can", "enum": ["can", "doip", "simulation"] },
        "vehicleDebug.doip.enabled": { "type": "boolean", "default": false },
        "vehicleDebug.doip.host": { "type": "string", "default": "192.168.0.10" },
        "vehicleDebug.doip.port": { "type": "number", "default": 13400 },
        "vehicleDebug.llm.allowRemoteDataUpload": { "type": "boolean", "default": false, "description": "Allow sending diagnostic excerpts to a remote LLM (opt-in)." }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "test:python": "python3 -m pytest tests/ -v --tb=short",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0"
  },
  "author": "Vehicle Debug",
  "license": "MIT"
}
